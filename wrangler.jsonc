{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "counsellor-performance-mis",
    "main": ".open-next/worker.js",
    "compatibility_date": "2024-09-23",
    "compatibility_flags": ["nodejs_compat"],
    "assets": {
        "binding": "ASSETS",
        "directory": ".open-next/assets",
    },
    // Only "staging" is configured for now (per product-owner decision) — the
    // "production" environment is deliberately not set up yet. Add an
    // `env.production` block here, mirroring `env.staging`, once a production
    // D1 database exists.
    "env": {
        "staging": {
            "name": "counsellor-performance-mis-staging",
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "counsellor-performance-staging",
                    "database_id": "47ad3445-df08-4990-8e35-ff8349ce53ad",
                    "migrations_dir": "migrations",
                },
            ],
        },
    },
}
